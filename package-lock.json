{
  "name": "log-platform",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "log-platform",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@log-platform/ingestor": {
      "resolved": "packages/ingestor",
      "link": true
    },
    "node_modules/@log-platform/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/ingestor": {
      "name": "@log-platform/ingestor",
      "dependencies": {
        "@log-platform/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@log-platform/shared",
      "version": "1.0.0"
    }
  }
}
